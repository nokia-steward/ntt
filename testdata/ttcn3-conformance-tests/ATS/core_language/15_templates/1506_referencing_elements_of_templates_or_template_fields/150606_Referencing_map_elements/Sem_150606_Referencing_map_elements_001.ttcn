/*****************************************************************
 ** @author   TTF T023
 ** @version  0.0.1
 ** @purpose  1:15.6.6, Expanding map containing omit on the LHS
 ** @verdict  pass accept, ttcn3verdict:pass
 *****************************************************************/

// The following requirements are tested:
// Omit: referencing an element within a map to which omit is assigned shall follow the rules
// specified in clause 6.2.15.7.

module Sem_150606_Referencing_map_elements_001 {

    type map from charstring to charstring TMap;

    type record TRec {
        integer a,
        TMap b optional
    }

    type component GeneralComp {
    }

    testcase TC_Sem_150606_Referencing_map_elements_001() runs on GeneralComp {
        var template TRec v_msg := {
            a := 1,
            b := omit
        };
        // expanding omit on the LHS
        v_msg.b["surname"] := "Doe";

        if (valueof(v_msg) == { a := 1, b := { ["surname"] := "Doe" }}) {
            setverdict(pass);
         } else {
             setverdict(fail);
         }
    }

    control{
        execute(TC_Sem_150606_Referencing_map_elements_001());
    }
}