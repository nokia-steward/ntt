/*****************************************************************
 ** @author   TTF 014
 ** @version  0.0.1
 ** @purpose  1:15.8.2, Ensure that referenced element of templates are not allowed to implicite restrict to template(value)
 ** @verdict  pass reject
 *****************************************************************/

/*
 * Reference element of a 'record of' template without restriction.
 * (see Table 13C: Implicit restrictions)
 *
 */
module NegSem_150802_ImplicitRestrictions_025 {

type component GeneralComp { }

type record of integer RecordOfInt;

testcase TC_NegSem_150802_ImplicitRestrictions_025() runs on GeneralComp {

	template RecordOfInt m_example := {1, 2, 3};

	var template (value) integer  v_value := m_example[2]; // Not allowed

	setverdict(fail);

}

control{
	execute(TC_NegSem_150802_ImplicitRestrictions_025());
}


}