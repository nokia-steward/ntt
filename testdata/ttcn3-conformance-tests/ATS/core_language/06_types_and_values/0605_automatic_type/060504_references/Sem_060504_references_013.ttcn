// @author   TTF T023
// @purpose  1:6.5, Ensure automatic type for references to unions;
// @verdict  pass accept, ttcn3verdict:pass
module Sem_060504_references_013 {

type component GeneralComp {}

type union U {
	universal charstring ucs,
	integer i,
}

function verifyType(inout U u) {
	setverdict(pass);
}

testcase TC_Sem_060504_references_013() runs on GeneralComp {
	var U u := { i := 1 };
	var v := u;
	verifyType(v);
}

control {
	execute(TC_Sem_060504_references_013());
}

}
