modulepar integer mp := 2;

testcase TC_Sem_060504_references_004() runs on GeneralComp {
	var i := mp;
	i := i + 1;
	if (i == 3) {
		setverdict(pass);
	} else {
		setverdict(fail);
	}
}

control {
	execute(TC_Sem_060504_references_004());
}

}
