// @author   TTF T023
// @purpose  1:6.5, Ensure automatic type for ports.
// @verdict  pass accept, ttcn3verdict:pass
module Sem_060504_references_008 {

type component GeneralComp {
	port Port p;
}

type port Port message { inout integer }

verifyType(inout Port p) {
	setverdict(pass);
}

testcase TC_Sem_060504_references_008() runs on GeneralComp {
	var v := p;
	verifyType(v);
}

control {
	execute(TC_Sem_060504_references_008());
}

}
