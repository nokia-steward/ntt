module Sem_060506_return_values_001 {

type component GeneralComp {}

type integer Alias;

function f() return Alias { return 1; }

function verifyType(inout Alias a) {
	setverdict(pass);
}

testcase TC_Sem_060506_return_values_001() runs on GeneralComp {
	var v := f();
	verifyType(v);
}

control {
	execute(TC_Sem_060506_return_values_001());
}

