// @verdict  pass accept, ttcn3verdict:pass
module Sem_060502_literals_005 {

type component GeneralComp {}

// inout parameters require strong typing and can be used to type verification.
function verifyType(inout hexstring hs) {
	setverdict(pass);
}

testcase TC_Sem_060502_literals_005() runs on GeneralComp {
	{ var v := '5'H; verifyType(v) }
}

control {
	execute(TC_Sem_060502_literals_005());
}

}
