/*****************************************************************
 ** @author   TTF T056
 ** @version  0.0.1
 ** @purpose  1:20.4, Verify that invoking an altstep as an alternative inside an embedded alt statement within an interleave statement is rejected (CR7195).
 ** @verdict  pass reject
 *****************************************************************/

// The following requirement is tested:
// Clause 20.4 restriction a) (CR7195):
// Control transfer statements activate, deactivate, repeat, all calls of altsteps and
// (direct and indirect) calls of user-defined functions, which include reception statements,
// shall not be present in interleave statements.

module NegSem_2004_InterleaveStatement_013 {

    type port MyPort message {
        inout integer
    }

    type component GeneralComp {
        port MyPort pt_In, pt_Out;
    }

    altstep a_innerStep() runs on GeneralComp {
        [] pt_In.receive(integer:2) {}
    }

    testcase TC_NegSem_2004_InterleaveStatement_013() runs on GeneralComp {
        connect(mtc:pt_In, mtc:pt_Out);
        pt_Out.send(integer:1);
        pt_Out.send(integer:2);
        pt_Out.send(integer:3);

        interleave {
            [] pt_In.receive(integer:1) {
                alt {
                    [] a_innerStep() { // error: all calls of altsteps are forbidden in interleave (CR7195)
                        setverdict(pass);
                    }
                }
            }
            [] pt_In.receive(integer:3) {}
        }
    }

    control {
        execute(TC_NegSem_2004_InterleaveStatement_013());
    }
}
